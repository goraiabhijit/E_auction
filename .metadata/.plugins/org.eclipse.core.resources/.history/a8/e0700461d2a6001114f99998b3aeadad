    align-items: center;
    justify-content: space-between;
    padding: 0 7%;
    border-top: 3px solid #f59e0b;
    box-shadow: 0 3px 12px rgba(0,0,0,0.25);
    position: sticky;
    top: 0;
    z-index: 1000;
}

.logo {
    font-size: 30px;
    font-weight: bold;
    color: white;
