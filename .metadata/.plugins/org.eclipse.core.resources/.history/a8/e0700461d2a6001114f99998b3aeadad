    margin-bottom: 35px;
}

footer {
    background: #030712;
    padding: 25px 7%;
    text-align: center;
    color: #9ca3af;
    font-size: 14px;
}

.modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.modal-content {
    background: white;
    color: #111827;
    width: 100%;
    max-width: 520px;
    padding: 30px;
    border-radius: 12px;
    position: relative;
    box-shadow: 0 15px 50px rgba(0, 0, 0, 0.35);
    animation: modalOpen 0.25s ease;
    max-height: 90vh;
    overflow-y: auto;
}

@keyframes modalOpen {
    from {
        transform: scale(0.8);
        opacity: 0;
    }
    to {
        transform: scale(1);
        opacity: 1;
    }
}

.close {
    position: absolute;
    right: 20px;
    top: 15px;
    font-size: 28px;
    color: #64748b;
    cursor: pointer;
}

.close:hover {
    color: #111827;
}

.modal-content h2 {
    font-size: 26px;
    margin-bottom: 18px;
    color: #111827;
}

.modal-content h2 span {
    color: #f59e0b;
}

.section-heading {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #f59e0b;
    font-weight: bold;
    margin: 15px 0 10px;
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 4px;
}

.modal-form-group {
    margin-bottom: 12px;
}

.modal-form-group label {
    display: block;
    margin-bottom: 4px;
    font-weight: bold;
    font-size: 13px;
    color: #334155;
}

.modal-form-group input,
.modal-form-group select,
.modal-form-group textarea {
    width: 100%;
    padding: 9px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 14px;
    outline: none;
}

.modal-form-group input:focus,
.modal-form-group select:focus,
.modal-form-group textarea:focus {
    border-color: #f59e0b;
    box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.15);
}

.error-message {
    color: #dc2626;
    font-size: 12px;
    margin-top: 4px;
    display: none;
}

.input-error {
    border: 1px solid #dc2626 !important;
}

.input-success {
    border: 1px solid #16a34a !important;
}

.modal-submit {
    width: 100%;
    padding: 12px;
    border: none;
    border-radius: 6px;
    background: #f59e0b;
    color: #111827;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    margin-top: 15px;
    transition: 0.3s;
}

.modal-submit:hover {
    background: #d97706;
    color: white;
}

@media (max-width: 650px) {
    .navbar {
        height: auto;
        padding: 15px 20px;
        flex-wrap: wrap;
        gap: 10px;
    }

    .logo {
        font-size: 24px;
    }

    .hero-title {
        font-size: 42px;
    }

    .hero-description {
        font-size: 16px;
    }

    .modal-content {
        padding: 22px 18px;
    }
}
</style>
</head>

<body>

<header class="navbar">
    <div class="logo">E-<span>Auction</span></div>
    <div class="nav-buttons">
        <button type="button" class="btn login-btn" onclick="openModal('loginModal')">Login</button>
        <button type="button" class="btn signup-btn" onclick="openModal('signupModal')">Sign Up</button>
    </div>
</header>

<main class="hero">
    <div class="hero-content">
        <h1 class="hero-title">Bid Smart. <span class="orange-text">Win Big.</span></h1>
        <p class="hero-description">
            Welcome to E-Auction, a secure and transparent online auction platform where buyers and sellers connect to discover, bid, and win amazing products.
        </p>
        <button type="button" class="register-btn" onclick="openModal('signupModal')">Register Now</button>
    </div>
</main>

<div class="modal" id="loginModal">
    <div class="modal-content">
        <span class="close" onclick="closeModal('loginModal')">&times;</span>
        <h2>Login to <span>E-Auction</span></h2>

        <form action="LoginServlet" method="POST" id="loginForm" novalidate>
            <div class="modal-form-group">
                <label for="loginEmail">Email ID</label>
                <input type="email" id="loginEmail" name="EmailId" placeholder="Enter Email ID">
                <div class="error-message" id="loginEmailError"></div>
            </div>

            <div class="modal-form-group">
                <label for="loginPassword">Password</label>
                <input type="password" id="loginPassword" name="Password" placeholder="Enter Password">
                <div class="error-message" id="loginPasswordError"></div>
            </div>

            <button type="submit" class="modal-submit">Login</button>
        </form>
    </div>
</div>

<div class="modal" id="signupModal">
    <div class="modal-content">
        <span class="close" onclick="closeModal('signupModal')">&times;</span>
        <h2>Create <span>Account</span></h2>

        <form action="RegisterServlet" method="POST" id="signupForm" novalidate>

            <div class="section-heading">Personal Details</div>

            <div class="modal-form-group">
                <label for="signupName">Name</label>
                <input type="text" id="signupName" name="name" placeholder="Enter full name">
                <div class="error-message" id="signupNameError"></div>
            </div>

            <div class="modal-form-group">
                <label for="signupEmail">Email ID</label>
                <input type="email" id="signupEmail" name="EmailId" placeholder="Enter email">
                <div class="error-message" id="signupEmailError"></div>
            </div>

            <div class="modal-form-group">
                <label for="signupPassword">Password</label>
                <input type="password" id="signupPassword" name="password" placeholder="Create password">
                <div class="error-message" id="signupPasswordError"></div>
            </div>

            <div class="modal-form-group">
                <label for="confirmPassword">Confirm Password</label>
                <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Re-enter password">
                <div class="error-message" id="confirmPasswordError"></div>
            </div>

            <div class="modal-form-group">
                <label for="signupPhone">Phone Number</label>
                <input type="tel" id="signupPhone" name="phone number" placeholder="Enter 10 digit phone number" maxlength="10" inputmode="numeric">
                <div class="error-message" id="signupPhoneError"></div>
            </div>

            <div class="modal-form-group">
                <label for="signupAddress">Address</label>
                <textarea id="signupAddress" name="Address" rows="2" placeholder="Enter address"></textarea>
                <div class="error-message" id="signupAddressError"></div>
            </div>

            <div class="modal-form-group">
                <label for="signupGender">Gender</label>
                <select id="signupGender" name="Gender">
                    <option value="">Select Gender</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
                <div class="error-message" id="signupGenderError"></div>
            </div>

            <div class="section-heading">Bank Details</div>

            <div class="modal-form-group">
                <label for="bankAccountHolder">Account Holder Name</label>
                <input type="text" id="bankAccountHolder" name="Account Holder Name" placeholder="Enter account holder name">
                <div class="error-message" id="bankAccountHolderError"></div>
            </div>

            <div class="modal-form-group">
                <label for="bankName">Bank Name</label>
                <input type="text" id="bankName" name="Bank Name" placeholder="Enter bank name">
                <div class="error-message" id="bankNameError"></div>
            </div>

            <div class="modal-form-group">
                <label for="bankAccNumber">Account Number</label>
                <input type="text" id="bankAccNumber" name="Account Number" placeholder="Enter account number" inputmode="numeric">
                <div class="error-message" id="bankAccNumberError"></div>
            </div>

            <div class="modal-form-group">
                <label for="bankIFSC">IFSC Code</label>
                <input type="text" id="bankIFSC" name="IFSC Code" placeholder="Enter IFSC code" maxlength="11">
                <div class="error-message" id="bankIFSCError"></div>
            </div>

            <div class="modal-form-group">
                <label for="bankBranch">Branch</label>
                <input type="text" id="bankBranch" name="Branch" placeholder="Enter branch name">
                <div class="error-message" id="bankBranchError"></div>
            </div>

            <button type="submit" class="modal-submit">Sign Up</button>
        </form>
    </div>
</div>

<footer>
    © 2026 E-Auction. All Rights Reserved.
</footer>

<script>
function openModal(id) {
    document.getElementById(id).style.display = "flex";
}

function closeModal(id) {
    document.getElementById(id).style.display = "none";
}

window.onclick = function(event) {
    if (event.target.classList.contains("modal")) {
        event.target.style.display = "none";
    }
};

function error(input, message) {
    input.classList.remove("input-success");
    input.classList.add("input-error");

    const e = document.getElementById(input.id + "Error");

    if (e) {
        e.textContent = message;
        e.style.display = "block";
    }

    return false;
}

function success(input) {
    input.classList.remove("input-error");
    input.classList.add("input-success");

    const e = document.getElementById(input.id + "Error");

    if (e) {
        e.textContent = "";
        e.style.display = "none";
    }

    return true;
}

function validateName(input) {
    if (input.value.trim() === "") {
        return error(input, "Name cannot be blank.");
    }

    if (!/^[A-Za-z ]+$/.test(input.value.trim())) {
        return error(input, "Name can contain alphabets only.");
    }

    return success(input);
}

function validateEmail(input) {
    if (input.value.trim() === "") {
        return error(input, "Email ID cannot be blank.");
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(input.value.trim())) {
        return error(input, "Enter a valid email ID.");
    }

    return success(input);
}

function validatePassword(input) {
    const password = input.value;

    if (password === "") {
        return error(input, "Password cannot be blank.");
    }

    if (password.length < 8) {
        return error(input, "Password must contain at least 8 characters.");
    }

    if (!/[A-Za-z]/.test(password)) {
        return error(input, "Password must contain an alphabet.");
    }

    if (!/[0-9]/.test(password)) {
        return error(input, "Password must contain a number.");
    }

    if (!/[^A-Za-z0-9]/.test(password)) {
        return error(input, "Password must contain a special character.");
    }

    return success(input);
}

function validateConfirmPassword(input) {
    const password = document.getElementById("signupPassword").value;

    if (input.value === "") {
        return error(input, "Confirm password cannot be blank.");
    }

    if (input.value !== password) {
        return error(input, "Passwords do not match.");
    }

    return success(input);
}

function validatePhone(input) {
    input.value = input.value.replace(/[^0-9]/g, "");

    if (input.value === "") {
        return error(input, "Phone number cannot be blank.");
    }

    if (input.value.length !== 10) {
        return error(input, "Phone number must contain 10 digits.");
    }

    return success(input);
}

function validateAccountNumber(input) {
    input.value = input.value.replace(/[^0-9]/g, "");

    if (input.value === "") {
        return error(input, "Account number cannot be blank.");
    }

    return success(input);
}

function validateIFSC(input) {
    input.value = input.value.toUpperCase();

    if (input.value === "") {
        return error(input, "IFSC Code cannot be blank.");
    }

    if (!/^[A-Z]{4}0[A-Z0-9]{6}$/.test(input.value)) {
        return error(input, "Enter a valid IFSC Code.");
    }

    return success(input);
}

function validateBlank(input) {
    if (input.value.trim() === "") {
        return error(input, "This field cannot be blank.");
    }

    return success(input);
}

document.getElementById("signupName").addEventListener("input", function() {
    validateName(this);
});

document.getElementById("signupEmail").addEventListener("input", function() {
    validateEmail(this);
});

document.getElementById("signupPassword").addEventListener("input", function() {
    validatePassword(this);

    const confirm = document.getElementById("confirmPassword");

    if (confirm.value !== "") {
        validateConfirmPassword(confirm);
    }
});

document.getElementById("confirmPassword").addEventListener("input", function() {
    validateConfirmPassword(this);
});

document.getElementById("signupPhone").addEventListener("input", function() {
    validatePhone(this);
});

document.getElementById("signupAddress").addEventListener("input", function() {
    validateBlank(this);
});

document.getElementById("signupGender").addEventListener("change", function() {
    if (this.value === "") {
        error(this, "Please select your gender.");
    } else {
        success(this);
    }
});

document.getElementById("bankAccountHolder").addEventListener("input", function() {
    validateBlank(this);
});

document.getElementById("bankName").addEventListener("input", function() {
    validateBlank(this);
});

document.getElementById("bankAccNumber").addEventListener("input", function() {
    validateAccountNumber(this);
});

document.getElementById("bankIFSC").addEventListener("input", function() {
    validateIFSC(this);
});

document.getElementById("bankBranch").addEventListener("input", function() {
    validateBlank(this);
});

document.getElementById("signupForm").addEventListener("submit", function(event) {
    event.preventDefault();

    const fields = [
        document.getElementById("signupName"),
        document.getElementById("signupEmail"),
        document.getElementById("signupPassword"),
        document.getElementById("confirmPassword"),
        document.getElementById("signupPhone"),
        document.getElementById("signupAddress"),
        document.getElementById("signupGender"),
        document.getElementById("bankAccountHolder"),
        document.getElementById("bankName"),
        document.getElementById("bankAccNumber"),
        document.getElementById("bankIFSC"),
        document.getElementById("bankBranch")
    ];

    validateName(fields[0]);
    validateEmail(fields[1]);
    validatePassword(fields[2]);
    validateConfirmPassword(fields[3]);
    validatePhone(fields[4]);
    validateBlank(fields[5]);

    if (fields[6].value === "") {
        error(fields[6], "Please select your gender.");
    } else {
        success(fields[6]);
    }

    validateBlank(fields[7]);
    validateBlank(fields[8]);
    validateAccountNumber(fields[9]);
    validateIFSC(fields[10]);
    validateBlank(fields[11]);

    const firstError = this.querySelector(".input-error");

    if (firstError) {
        firstError.focus();
        return;
    }

    this.submit();
});

document.getElementById("loginEmail").addEventListener("input", function() {
    validateEmail(this);
});

document.getElementById("loginPassword").addEventListener("input", function() {
    if (this.value.trim() === "") {
        error(this, "Password cannot be blank.");
    } else {
        success(this);
    }
});

document.getElementById("loginForm").addEventListener("submit", function(event) {
    event.preventDefault();

    const email = document.getElementById("loginEmail");
    const password = document.getElementById("loginPassword");

    validateEmail(email);

    if (password.value.trim() === "") {
        error(password, "Password cannot be blank.");
    } else {
        success(password);
    }

    const firstError = this.querySelector(".input-error");

    if (firstError) {
        firstError.focus();
        return;
    }

    this.submit();
});

const fields = Array.from(
    document.querySelectorAll("#signupForm input, #signupForm select, #signupForm textarea")
);

fields.forEach(function(field, index) {
    field.addEventListener("keydown", function(event) {
        if (event.key === "Enter") {
            event.preventDefault();

            if (field.classList.contains("input-error")) {
                field.focus();
                return;
            }

            if (index < fields.length - 1) {
                fields[index + 1].focus();
            }
        }
    });
});
</script>

</body>
</html>
